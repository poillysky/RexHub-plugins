{
  "modules": [
    {
      "id": "rexhub.hongguo.video",
      "title": "红果短剧",
      "description": "红果短剧全能力插件：榜单/筛选/目录/搜索/详情 + 播放流解密代理，单进程提供全部接口",
      "version": "4.0.0",
      "author": "RexHub",
      "category": "shortdrama",
      "file": "modules/hongguo-video.mjs",
      "capabilities": [
        "playback.extract",
        "playback.stream",
        "resource.search",
        "metadata.tv",
        "danmaku.search",
        "danmaku.detail",
        "danmaku.fetch"
      ],
      "endpoints": {
        "playback.extract": {
          "path": "/v1/rankings",
          "method": "GET"
        },
        "playback.stream": {
          "path": "/v1/episodes/{id}/stream",
          "method": "GET"
        },
        "resource.search": {
          "path": "/v1/search",
          "method": "GET"
        },
        "metadata.tv": {
          "path": "/v1/series/{id}",
          "method": "GET"
        },
        "danmaku.search": {
          "path": "/v1/dandanplay/api/v2/search/anime",
          "method": "GET"
        },
        "danmaku.detail": {
          "path": "/v1/dandanplay/api/v2/bangumi/{animeId}",
          "method": "GET"
        },
        "danmaku.fetch": {
          "path": "/v1/dandanplay/api/v2/comment/{commentId}",
          "method": "GET"
        }
      },
      "runtime": {
        "type": "isolated",
        "engine": "node",
        "entrypoint": "module.mjs"
      }
    }
  ]
}